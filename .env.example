# ========================
# GOOGLE GEMINI AI API
# ========================
# Get from: https://ai.google.dev/
# Steps: Sign in → Create API Key → Copy here
# IMPORTANT: Keep this secret! Don't commit to Git!
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# ========================
# SUPABASE DATABASE
# ========================
# Get from: https://supabase.com/
# Steps: Create project → Settings → API Keys
# NEXT_PUBLIC_SUPABASE_URL: Public, can be shared
# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public key for client
# SUPABASE_SERVICE_ROLE_KEY: SECRET! Never share!
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================
# DATABASE CONNECTION
# ========================
# Format: postgresql://user:password@host:port/database
# Get from: Supabase → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:password@your-host:5432/postgres

# ========================
# NEXTAUTH (Authentication)
# ========================
# Generate NEXTAUTH_SECRET: openssl rand -hex 32
# NEXTAUTH_URL: Your application URL
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_generated_secret_here

# ========================
# FILE UPLOAD CONFIG
# ========================
# Maximum file size: 10MB
MAX_FILE_SIZE=10485760
# Upload directory (local development only)
UPLOAD_DIR=./uploads
